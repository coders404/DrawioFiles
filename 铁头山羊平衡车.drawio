        </mxCell>
        <mxCell id="a6ZhUhQlljPnyHPRieFO-170" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Comic Sans MS;" value="为什么存在误差呢？" vertex="1">
          <mxGeometry height="40" width="210" x="-1720" y="9350" as="geometry" />
        </mxCell>
        <mxCell id="a6ZhUhQlljPnyHPRieFO-172" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Comic Sans MS;" value="我们单片机对T的测量并不准确，假如我们用单片机的定时器的输入捕获功能去测量时间间隔T，我们假设定时器的分辨率是1us，我们假设这个T的值是10.5us，我们小数部分肯定得不到，假设我们测的时间是10us呢，误差就5%左右，假设我们现在T是100us呢，那误差就是0.005%误差了，也就是说我们电机转的越慢的时候，误差就越小，&lt;br&gt;当我们电机转的越慢的时候呢，我们测量的结果就越精确" vertex="1">
          <mxGeometry height="260" width="600" x="-1490" y="9270" as="geometry" />
        </mxCell>
        <mxCell id="Na6YzUiE7NjN93yWb_PQ-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;strokeWidth=2;fontSize=35;" value="5.1 节 - MPU6050- 简介" vertex="1">
