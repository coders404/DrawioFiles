          <mxGeometry height="40" width="210" x="-1713.4" y="8000" as="geometry" />
        </mxCell>
        <mxCell id="a6ZhUhQlljPnyHPRieFO-148" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Comic Sans MS;" value="我们编码器的波形是由我们编码器产生的，而编码器是由我们电机所带动的，而我们取得的▲T的起点和终点的时间，是由我们单片机所决定的，因此电机带动我们编码器示数的变化，和我们单片机取的时间，并不会完全同步" vertex="1">
          <mxGeometry height="200" width="447" x="-1364.11" y="7990" as="geometry" />
        </mxCell>
        <mxCell id="a6ZhUhQlljPnyHPRieFO-153" edge="1" parent="1" source="a6ZhUhQlljPnyHPRieFO-150" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;strokeColor=light-dark(#000000,#00FF00);strokeWidth=3;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;labelBackgroundColor=default;endArrow=classic;" target="a6ZhUhQlljPnyHPRieFO-151">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a6ZhUhQlljPnyHPRieFO-150" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Comic Sans MS;" value="误差占多少比例" vertex="1">
          <mxGeometry height="40" width="210" x="-1700" y="8230" as="geometry" />
        </mxCell>
        <mxCell id="a6ZhUhQlljPnyHPRieFO-151" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Comic Sans MS;" value="对于前后两段多出来的，它都是不足以编码器的一个示数的，前面&amp;lt;1，后面&amp;lt;1，我们直接取最大值，&amp;lt;2,我们用&amp;lt;2 / M，这样我们就算出来误差占整个测量结果的比例是多少，当我们电机旋转的越快的时候，在等间隔▲T示数的变化，编码器示数值M就越大，误差就非常小，测量的结果就越准确" vertex="1">
          <mxGeometry height="160" width="630" x="-1364.8" y="8200" as="geometry" />
        </mxCell>
